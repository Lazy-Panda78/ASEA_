# ASEA Environment Variables Template

# Django Configuration
SECRET_KEY=django-insecure-change-this-in-production-asea-key-32bytes-minimum
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration (PostgreSQL)
DATABASE_NAME=asea_db
DATABASE_USER=asea_user
DATABASE_PASSWORD=asea_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# JWT Security
JWT_SECRET_KEY=jwt-secret-key-change-in-production-32bytes-minimum
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# GitHub API Configuration
GITHUB_TOKEN=your_github_personal_access_token_here

# LLM API Configuration (Module 3 Negative-Space Scanner)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

